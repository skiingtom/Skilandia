{
  "name": "skilandia",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win:nowine": "npm run build && electron-builder --win --x64 --publish never -c.win.signAndEditExecutable=false",
    "test": "tsx tests/playthrough.ts"
  },
  "devDependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@types/three": "^0.187.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "three": "^0.187.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "description": "Build and run your own ski resort.",
  "author": "Skilandia",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.skilandia.game",
    "productName": "Skilandia",
    "copyright": "Skilandia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skilandia",
      "artifactName": "Skilandia-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Skilandia-${version}-portable.exe"
    }
  }
}
